# Force LF line endings for all text files so Prettier format:check
# passes on Windows CI (matching endOfLine: lf in .prettierrc.json).
* text=auto eol=lf

# Binaries — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tgz binary
*.ttf binary
*.woff binary
*.woff2 binary
