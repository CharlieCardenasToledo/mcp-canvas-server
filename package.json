{
    "name": "@charlie.act7/canvas-mcp-server",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CharlieCardenasToledo/mcp-canvas-server.git"
    },
    "homepage": "https://github.com/CharlieCardenasToledo/mcp-canvas-server#readme",
    "bugs": {
        "url": "https://github.com/CharlieCardenasToledo/mcp-canvas-server/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "version": "1.2.3",
    "description": "A secure Model Context Protocol server for Canvas LMS courses, assignments, grading, and communication.",
    "main": "dist/index.js",
    "bin": {
        "canvas-mcp": "dist/index.js"
    },
    "type": "module",
    "files": [
        "dist",
        "README.md",
        "llms-install.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "node scripts/clean.mjs",
        "build": "npm run clean && tsc",
        "typecheck": "tsc --noEmit -p tsconfig.tests.json",
        "start": "node dist/index.js",
        "start:http": "node dist/index.js serve-http",
        "start:rest": "node dist/index.js serve-rest",
        "dev": "tsc --watch",
        "chat": "tsx src/ollama_bridge.ts",
        "lint": "eslint src tests scripts eslint.config.js",
        "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,mjs}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml,md}\"",
        "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,mjs}\" \"*.{json,md,yml,yaml}\" \".github/**/*.{yml,yaml,md}\"",
        "test": "tsx --test tests/**/*.test.ts",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
        "package:smoke": "node scripts/package-smoke.mjs",
        "release:check": "node scripts/release-check.mjs",
        "prepublishOnly": "npm run check"
    },
    "keywords": [
        "mcp",
        "canvas",
        "lms",
        "ai",
        "agent",
        "server"
    ],
    "author": "Charlie Cárdenas Toledo",
    "license": "MIT",
    "dependencies": {
        "@fastify/swagger": "^9.5.2",
        "@fastify/swagger-ui": "^6.1.1",
        "@google/genai": "^2.8.0",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "axios": "^1.19.0",
        "chalk": "^5.3.0",
        "commander": "^11.1.0",
        "conf": "^12.0.0",
        "dotenv": "^16.3.1",
        "fastify": "^5.11.0",
        "form-data": "^4.0.5",
        "inquirer": "^9.2.12",
        "ollama": "^0.6.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/inquirer": "^9.0.7",
        "@types/node": "^24.10.0",
        "eslint": "^9.39.2",
        "nodemon": "^3.1.11",
        "prettier": "^3.6.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.1"
    },
    "engines": {
        "node": ">=22.14.0"
    },
    "mcpName": "io.github.charliecardenastoledo/canvas-lms"
}
